    private void swap(
            int row1,
            int col1,
            int row2,
            int col2
    ) {

        Candy temp =
                board[row1][col1];

        board[row1][col1] =
                board[row2][col2];

        board[row2][col2] =
                temp;
    }

    private Set<Integer> findMatches() {

        Set<Integer> matches =
                new HashSet<>();

        for (int row = 0; row < SIZE; row++) {

            int start = 0;

            while (start < SIZE) {

                Candy first =
                        board[row][start];

                if (first == null) {
                    start++;
                    continue;
                }

                int end = start + 1;

                while (end < SIZE &&
                        board[row][end] != null &&
                        board[row][end].type ==
                                first.type) {

                    end++;
                }

                if (end - start >= 3) {

                    for (int col = start;
                         col < end;
                         col++) {

                        matches.add(
                                row * SIZE + col
                        );
                    }
                }

                start = end;
            }
        }

        for (int col = 0; col < SIZE; col++) {

            int start = 0;

            while (start < SIZE) {

                Candy first =
                        board[start][col];

                if (first == null) {
                    start++;
                    continue;
                }

                int end = start + 1;

                while (end < SIZE &&
                        board[end][col] != null &&
                        board[end][col].type ==
                                first.type) {

                    end++;
                }

                if (end - start >= 3) {

                    for (int row = start;
                         row < end;
                         row++) {

                        matches.add(
                                row * SIZE + col
                        );
                    }
                }

                start = end;
            }
        }

        return matches;
    }

    private void resolveMatches() {

        int combo = 0;

        while (true) {

            Set<Integer> matches =
                    findMatches();

            if (matches.isEmpty()) {
                break;
            }

            combo++;

            int gained =
                    matches.size() *
                            100 *
                            combo;

            score += gained;

            clearMatches(matches);

            applyGravity();

            refillBoard();
        }
    }

    private void clearMatches(
            Set<Integer> matches
    ) {

        for (Integer index : matches) {

            int row =
                    index / SIZE;

            int col =
                    index % SIZE;

            board[row][col] = null;
        }
    }

    private void applyGravity() {

        for (int col = 0; col < SIZE; col++) {

            int writeRow = SIZE - 1;

            for (int row = SIZE - 1;
                 row >= 0;
                 row--) {

                Candy candy =
                        board[row][col];

                if (candy != null) {

                    board[writeRow][col] =
                            candy;

                    if (writeRow != row) {
                        board[row][col] = null;
                    }

                    writeRow--;
                }
            }

            while (writeRow >= 0) {

                board[writeRow][col] = null;
                writeRow--;
            }
        }
    }

    private void refillBoard() {

        for (int row = 0; row < SIZE; row++) {

            for (int col = 0; col < SIZE; col++) {

                if (board[row][col] == null) {

                    int type =
                            random.nextInt(
                                    CANDY_TYPES
                            );

                    board[row][col] =
                            createCandy(
                                    type,
                                    row,
                                    col
                            );
                }
            }
        }
    }


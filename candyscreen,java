    private void handleSelection(
            int row,
            int col
    ) {

        if (selectedRow == -1) {

            selectedRow = row;
            selectedCol = col;

            return;
        }

        if (selectedRow == row &&
                selectedCol == col) {

            selectedRow = -1;
            selectedCol = -1;

            return;
        }

        if (isAdjacent(
                selectedRow,
                selectedCol,
                row,
                col
        )) {

            trySwap(
                    selectedRow,
                    selectedCol,
                    row,
                    col
            );
        }

        selectedRow = -1;
        selectedCol = -1;
    }

    private boolean screenToBoard(
            int screenX,
            int screenY
    ) {

        Ray ray =
                camera.getPickRay(
                        screenX,
                        screenY
                );

        if (!ray.intersects(
                boardPlane,
                touchPoint
        )) {

            return false;
        }

        float boardHalf =
                ((SIZE - 1) / 2f) * CELL;

        float x = touchPoint.x;
        float z = touchPoint.z;

        float colFloat =
                x / CELL +
                        (SIZE - 1) / 2f;

        float rowFloat =
                z / CELL +
                        (SIZE - 1) / 2f;

        int col =
                Math.round(colFloat);

        int row =
                Math.round(rowFloat);

        if (!isInside(row, col)) {
            return false;
        }

        float centerX = boardX(col);
        float centerZ = boardZ(row);

        if (Math.abs(x - centerX) >
                CELL * 0.50f) {

            return false;
        }

        if (Math.abs(z - centerZ) >
                CELL * 0.50f) {

            return false;
        }

        selectedRow = row;
        selectedCol = col;

        return true;
    }

    private boolean isInside(
            int row,
            int col
    ) {

        return row >= 0 &&
                row < SIZE &&
                col >= 0 &&
                col < SIZE;
    }

    private boolean isAdjacent(
            int row1,
            int col1,
            int row2,
            int col2
    ) {

        int distance =
                Math.abs(row1 - row2) +
                        Math.abs(col1 - col2);

        return distance == 1;
    }

    private void trySwap(

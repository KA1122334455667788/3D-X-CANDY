public class CandyScreen extends InputAdapter implements com.badlogic.gdx.Screen {

    private static final int SIZE = 7;
    private static final float CELL = 1.35f;
    private static final int CANDY_TYPES = 6;
    private static final int START_MOVES = 25;

    private final ModelBatch modelBatch;
    private final Environment environment;
    private final PerspectiveCamera camera;
    private final ModelBuilder modelBuilder;
    private final Random random = new Random();

    private final Candy[][] board = new Candy[SIZE][SIZE];
    private final Array<Model> models = new Array<>();

    private int score = 0;
    private int moves = START_MOVES;
    private int level = 1;

    private int selectedRow = -1;
    private int selectedCol = -1;

    private float touchDownX;
    private float touchDownY;

    private boolean busy = false;
    private float animationTimer = 0f;

    public CandyScreen() {
        modelBatch = new ModelBatch();
        modelBuilder = new ModelBuilder();

        environment = new Environment();
        environment.set(
                new ColorAttribute(
                        ColorAttribute.AmbientLight,
                        0.75f,
                        0.75f,
                        0.75f,
                        1f
                )
        );

        camera = new PerspectiveCamera(
                55f,
                Gdx.graphics.getWidth(),
                Gdx.graphics.getHeight()
        );

        camera.position.set(
                0f,
                10.5f,
                9.5f
        );

        camera.lookAt(0f, 0f, 0f);
        camera.near = 0.1f;
        camera.far = 100f;
        camera.update();

        createBoard();

        Gdx.input.setInputProcessor(this);
    }

    private void createBoard() {
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {

                int type;

                do {
                    type = random.nextInt(CANDY_TYPES);
                } while (createsMatch(row, col, type));

                board[row][col] = createCandy(type, row, col);
            }
        }
    }

    private Candy createCandy(int type, int row, int col) {

        Color color;

        switch (type) {
            case 0:
                color = new Color(1f, 0.15f, 0.25f, 1f);
                break;

            case 1:
                color = new Color(1f, 0.75f, 0.05f, 1f);
                break;

            case 2:
                color = new Color(0.15f, 0.85f, 1f, 1f);
                break;

            case 3:
                color = new Color(0.35f, 1f, 0.35f, 1f);
                break;

            case 4:
                color = new Color(0.75f, 0.25f, 1f, 1f);
                break;

            default:
                color = new Color(1f, 0.35f, 0.65f, 1f);
                break;
        }

        Material material = new Material(
                ColorAttribute.createDiffuse(color)
        );

        Model model = modelBuilder.createSphere(
                0.48f,
                0.48f,
                0.48f,
                24,
                24,
                material,
                VertexAttributes.Usage.Position |
                        VertexAttributes.Usage.Normal
        );

        models.add(model);

        ModelInstance instance = new ModelInstance(model);

        float x = boardX(col);
        float z = boardZ(row);

        instance.transform.setToTranslation(x, 0f, z);

        return new Candy(type, instance);
    }

    private float boardX(int col) {
        return (col - (SIZE - 1) / 2f) * CELL;
    }

    private float boardZ(int row) {
        return (row - (SIZE - 1) / 2f) * CELL;
    }

    private boolean createsMatch(int row, int col, int type) {

        if (col >= 2) {
            Candy a = board[row][col - 1];
            Candy b = board[row][col - 2];

            if (a != null &&
                    b != null &&
                    a.type == type &&
                    b.type == type) {
                return true;
            }
        }

        if (row >= 2) {
            Candy a = board[row - 1][col];
            Candy b = board[row - 2][col];

            if (a != null &&
                    b != null &&
                    a.type == type &&
                    b.type == type) {
                return true;
            }
        }

        return false;
    }


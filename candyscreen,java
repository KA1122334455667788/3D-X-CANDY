    private int level = 1;

    private int selectedRow = -1;
    private int selectedCol = -1;

    private float touchDownX;
    private float touchDownY;

    private boolean busy = false;
 private final CandyResult result = new CandyResult();
private final CandyGame game;
private float animationTimer = 0f;

    private final Vector3 touchPoint = new Vector3();
    private final Plane boardPlane =
            new Plane(new Vector3(0f, 1f, 0f), 0f);

    public CandyScreen(CandyGame game) {
    this.game = game;

        modelBatch = new ModelBatch();
        modelBuilder = new ModelBuilder();

        environment = new Environment();

        environment.set(
                new ColorAttribute(
                        ColorAttribute.AmbientLight,
                        0.75f,
                        0.75f,
                        0.75f,
                        1f
                )
        );

        camera = new PerspectiveCamera(
                55f,
                Gdx.graphics.getWidth(),
                Gdx.graphics.getHeight()
        );

        camera.position.set(
                0f,
                10.5f,
                9.5f
        );

        camera.lookAt(0f, 0f, 0f);

        camera.near = 0.1f;
        camera.far = 100f;

        camera.update();

        createBoard();

        Gdx.input.setInputProcessor(this);
    }

    private void createBoard() {

        for (int row = 0; row < SIZE; row++) {

            for (int col = 0; col < SIZE; col++) {

                int type;

                do {
                    type = random.nextInt(CANDY_TYPES);
                } while (createsMatch(row, col, type));

                board[row][col] =
                        createCandy(type, row, col);
            }
        }
    }

    private Candy createCandy(
            int type,
            int row,
            int col
    ) {

        Color color;

        switch (type) {

            case 0:
                color = new Color(
                        1f,
                        0.15f,
                        0.25f,
                        1f
                );
                break;

            case 1:
                color = new Color(
                        1f,
                        0.75f,
                        0.05f,
                        1f
                );
                break;

            case 2:
                color = new Color(
                        0.15f,
                        0.85f,
                        1f,
                        1f
                );
                break;

            case 3:
                color = new Color(
                        0.35f,
                        1f,
                        0.35f,
                        1f
                );
                break;

            case 4:
                color = new Color(
                        0.75f,
                        0.25f,
                        1f,
                        1f
                );
                break;

            default:
                color = new Color(
                        1f,
                        0.35f,
                        0.65f,
                        1f
                );
                break;
        }

        Material material =
                new Material(
                        ColorAttribute.createDiffuse(color)
                );

        Model model =
                modelBuilder.createSphere(
                        0.48f,
                        0.48f,
                        0.48f,
                        24,
                        24,
                        material,
                        VertexAttributes.Usage.Position |
                                VertexAttributes.Usage.Normal
                );

        models.add(model);

        ModelInstance instance =
                new ModelInstance(model);

        instance.transform.setToTranslation(
                boardX(col),
                0f,
                boardZ(row)
        );

        return new Candy(type, instance);
    }

    private float boardX(int col) {

        return (col - (SIZE - 1) / 2f) * CELL;
    }

    private float boardZ(int row) {

        return (row - (SIZE - 1) / 2f) * CELL;
    }

    private boolean createsMatch(
            int row,
            int col,
            int type
    ) {

        if (col >= 2) {

            Candy a = board[row][col - 1];
            Candy b = board[row][col - 2];

            if (a != null &&
                    b != null &&
                    a.type == type &&
                    b.type == type) {

                return true;
            }
        }

        if (row >= 2) {

            Candy a = board[row - 1][col];
            Candy b = board[row - 2][col];

            if (a != null &&
                    b != null &&
                    a.type == type &&
                    b.type == type) {

                return true;
            }
        }

        return false;
    }

    @Override
    public void render(float delta) {

        animationTimer += delta;

        Gdx.gl.glClearColor(
                0.035f,
                0.04f,
                0.10f,
                1f
        );

        Gdx.gl.glClear(
                GL20.GL_COLOR_BUFFER_BIT |
                        GL20.GL_DEPTH_BUFFER_BIT
        );

        camera.update();

        modelBatch.begin(camera);

        for (int row = 0; row < SIZE; row++) {

            for (int col = 0; col < SIZE; col++) {

                Candy candy = board[row][col];

                if (candy != null) {

                    updateCandyPosition(
                            candy,
                            row,
                            col
                    );

                    modelBatch.render(
                            candy.instance,
                            environment
                    );
                }
            }
        }

        modelBatch.end();
    }

    private void updateCandyPosition(
            Candy candy,
            int row,
            int col
    ) {

        float x = boardX(col);
        float z = boardZ(row);

        candy.instance.transform.setToTranslation(
                x,
                0f,
                z
        );

        if (row == selectedRow &&
                col == selectedCol) {

            float pulse =
                    1f +
                            0.10f *
                                    (float) Math.sin(
                                            animationTimer * 8f
                                    );

            candy.instance.transform.scale(
                    pulse,
                    pulse,
                    pulse
            );
        }
    }

